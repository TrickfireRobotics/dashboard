{
    "name": "TrickFire Dashboard",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:26-alpine",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            }
        }
    },
    "forwardPorts": [3000],
    "portsAttributes": {
        "3000": {
            "label": "Dev Server",
            "onAutoForward": "openBrowser"
        }
    },
    "containerEnv": {
        "DATABASE_PATH": "db/dashboard.db"
    },
    "postCreateCommand": "corepack enable && pnpm install && cp -n .env.example .env.local && pnpm setup",
    "remoteUser": "trickfire"
}
