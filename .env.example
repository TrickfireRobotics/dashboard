# App -----------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Space-separated list of extra allowed origins (leave empty for same-origin only)
BETTER_AUTH_TRUSTED_ORIGINS=

# Auth ----------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Database --------------------------------
DATABASE_PATH=./db/dashboard.db
# Encrypts API Key Vault secrets at rest (AES-256-GCM). REQUIRED in production.
# In local dev, if unset, a key is auto-generated and persisted to db/vault.key.
# Losing/rotating this key makes existing vault entries unrecoverable.
VAULT_ENCRYPTION_KEY=<openssl rand -hex 32>

# Email ----------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=TrickFire Robotics <noreply@trickfirerobotics.com>

# Minecraft --------------------------------
MINECRAFT_SERVER_HOST=localhost
MINECRAFT_SERVER_PORT=25565
MINECRAFT_SERVER_PATH=
MINECRAFT_WORLD_PATH=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
# Comma-separated, colon for custom skin URL
MINECRAFT_BOT_NAMES=Bot:https://s.namemc.com/i/b801de2a7ac9dc5c.png,Bot2:https://s.namemc.com/i/b801de2a7ac9dc5c.png
PL3XMAP_URL=http://localhost:8080

# Tailscale -----------------------------------
# API key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=-

# OnShape ---------------------------------
ONSHAPE_BASE_URL=https://trickfirerobotics.onshape.com/api
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Admin Seed -------------------------------
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Github config -----------------------------
GITHUB_ORG=trickfirerobotics
GITHUB_TOKEN=
